# Plataforma de asistencia (ficticia)
PORTAL_URL=http://localhost:8000
PORTAL_USER=demo
PORTAL_PASSWORD=demo1234
PORTAL_SESSION_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
PORTAL_NEW_SERVICE_EVERY=7
PORTAL_SERVICE_TTL=45

# Bot
DB_PATH=data/gruas.db
POLL_INTERVAL_SECONDS=4
HEADLESS=true
# Vacío = Chromium de Playwright. msedge / chrome = navegador instalado (no hace falta 'playwright install')
BROWSER_CHANNEL=
LOG_LEVEL=INFO

# Telegram (opcional; sin esto los avisos solo salen en el log)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
